{
  "id": "queue-gt3b-abort-pending-then-drain",
  "prd": "prd-chat-queue.md GT-3 abort-pending",
  "sessionId": "s0",
  "events": [
    {
      "t": "BEGIN_STREAM",
      "expect": {
        "phase": "streaming",
        "occupied": true,
        "sendButton": "chat-stop"
      }
    },
    {
      "t": "TOKEN",
      "delta": "半截",
      "expect": {
        "phase": "streaming",
        "occupied": true,
        "sendButton": "chat-stop"
      }
    },
    {
      "t": "ENQUEUE",
      "id": "q-m2-pending",
      "kind": "user",
      "text": "abort-pending 窗口不得先发出",
      "dbId": "db-m2-pending",
      "expect": {
        "phase": "streaming",
        "occupied": true,
        "sendButton": "chat-stop",
        "visibleQueueCount": 1,
        "queueLength": 1
      }
    },
    {
      "t": "APPLY_USER_STOP",
      "partialId": "msg-gt3b",
      "expect": {
        "phase": "done",
        "occupied": true,
        "sendButton": "chat-send",
        "visibleQueueCount": 1,
        "queueLength": 1
      }
    },
    {
      "t": "UPSERT",
      "role": "assistant",
      "id": "msg-gt3b",
      "content": "半截",
      "finishReason": "aborted",
      "expect": {
        "phase": "streaming",
        "occupied": true,
        "sendButton": "chat-stop",
        "visibleQueueCount": 0,
        "queueLength": 0,
        "finishReason": { "id": "msg-gt3b", "value": "aborted" }
      }
    }
  ]
}
