{
  "name": "@oasismind/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./router": "./src/router.ts"
  },
  "scripts": {
    "dev": "tsx watch --exclude \"**/__tests__/**\" --exclude \"**/*.test.ts\" src/index.ts",
    "dev:once": "tsx src/index.ts",
    "dev:mock": "cross-env SERVER_PORT=3011 MOCK_LLM=true MOCK_MCP=true MOCK_NATIVE_TOOLS=true REQUIRE_APPROVAL=false tsx src/index.ts",
    "start": "tsx src/index.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:sync": "tsx src/scripts/sync.ts",
    "db:sync:watch": "tsx src/scripts/sync.ts --watch",
    "sync-free-keys": "tsx src/scripts/sync-free-keys.ts",
    "sync-free-keys:watch": "tsx src/scripts/sync-free-keys.ts --watch",
    "db:cleanup-test-sessions": "tsx src/scripts/cleanup-test-sessions.ts",
    "cleanup:smoke-artifacts": "tsx src/scripts/cleanup-smoke-artifacts.ts",
    "reset:runtime": "tsx src/scripts/reset-runtime-data.ts",
    "integration:smoke": "tsx src/scripts/integration-smoke.ts",
    "integration:smoke:platform": "tsx src/scripts/integration-smoke.ts --platform",
    "integration:smoke:platform:quick": "tsx src/scripts/integration-smoke.ts --quick-platform",
    "integration:smoke:platform:medium": "tsx src/scripts/integration-smoke.ts --medium-platform",
    "integration:smoke:platform:extended": "tsx src/scripts/integration-smoke.ts --extended-platform",
    "read-article:spot": "tsx src/scripts/read-article-spot.ts",
    "zhihu": "tsx src/scripts/zhihuCli.ts",
    "ocr:check": "tsx src/scripts/ocr-check.ts",
    "feishu:authorize": "tsx src/scripts/feishu-authorize.ts",
    "feishu:export-wiki": "tsx src/scripts/feishuExportWiki.ts",
    "diag:agentmail": "tsx src/scripts/diag-agentmail.ts",
    "email:test": "tsx src/scripts/email-test.ts",
    "email:probe": "tsx src/scripts/email-channel-probe.ts",
    "smoke:yuque-feishu": "tsx src/scripts/smoke-yuque-feishu-full.ts",
    "smoke:yuque-feishu:deep": "tsx src/scripts/smoke-yuque-feishu-deep.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@mozilla/readability": "0.5.0",
    "@oasismind/mock-llm-core": "workspace:*",
    "@oasismind/shared": "workspace:*",
    "@prisma/client": "6.9.0",
    "@trpc/server": "11.1.0",
    "bullmq": "5.79.3",
    "chokidar": "5.0.0",
    "compression": "1.8.1",
    "cors": "2.8.5",
    "dotenv": "16.5.0",
    "express": "5.1.0",
    "express-rate-limit": "8.6.0",
    "gray-matter": "4.0.3",
    "ioredis": "5.11.1",
    "js-yaml": "5.2.0",
    "jsdom": "23.2.0",
    "mammoth": "1.12.0",
    "node-cron": "4.5.0",
    "nodemailer": "9.0.3",
    "playwright": "1.61.1",
    "qrcode": "^1.5.4",
    "superjson": "2.2.2",
    "tesseract.js": "6.0.0",
    "turndown": "7.2.4",
    "undici": "8.9.0",
    "unpdf": "1.8.0",
    "ws": "8.21.1",
    "youtube-transcript-api-js": "4.0.0",
    "zod": "3.25.56",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.18",
    "@types/express": "5.0.2",
    "@types/js-yaml": "4.0.9",
    "@types/jsdom": "21.1.7",
    "@types/node-cron": "3.0.11",
    "@types/nodemailer": "8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "8.18.1",
    "prisma": "6.9.0",
    "tsx": "4.21.0",
    "typescript": "5.8.3",
    "vitest": "3.2.3"
  }
}
