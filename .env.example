# encoding: utf-8
# 本文件必须用 UTF-8 保存/打开（含中文注释）。乱码时：编辑器右下角编码 → 通过编码重新打开 → UTF-8。
#
# ===== 环境变量（单一 .env）=====
# 本项目是单用户本地优先：部署配置与密钥全部写在项目根目录 .env。
# .gitignore 已忽略 .env，不会进 Git。复制本文件为起点：cp .env.example .env
#
# 书写铁律：
#   1) KEY=VALUE 单独一行；说明写在上一行 # 注释。禁止 KEY=value  # 尾注（会被吃进值）。
#   2) 按下方分区填，不要在文件末尾再堆一坨无注释的 VITE_* / ONEBOT_*。
#   3) NapCat/OneBot 已退役：ONEBOT_ENABLED 必须 false；手机 QQ 只用 QQ_BOT_*。
#   4) 改完必须重启 server（tsx watch 不重载 .env）。
#
# 敏感度提示（仅供自查）：
#   公开：SERVER_PORT、模型名、CORS_ORIGINS、业务开关默认值
#   私有：各厂商 API Key、AUTH_PASSWORD/AUTH_TOKEN、CREDENTIAL_MASTER_KEY、FEISHU_*、
#         GITHUB_TOKEN、CLOUDFLARE_TUNNEL_TOKEN、AGENTMAIL_*、平台 Cookie 等
# CREDENTIAL_MASTER_KEY 丢失即凭据全损，请离线备份；高敏凭据建议定期轮换。

# ===== Database =====
DATABASE_URL="file:./dev.db"

# ===== 业务行为配置（config.yaml）=====
# 与部署/密钥无关的业务参数（如 SessionStreamHub 缓冲大小、事件 TTL 等）
# 统一放到项目根目录 config.yaml，便于教学与版本管理。
# 详见 config.yaml 注释。

# ===== Server =====
SERVER_PORT=3010
# 监听地址：默认 127.0.0.1（防局域网误暴露）；Docker / 需外网直连设 0.0.0.0
# SERVER_HOST=127.0.0.1
# 逗号分隔；不设则默认 localhost:3000 / 127.0.0.1:3000
# CORS_ORIGINS=https://oasismind.example.com,http://127.0.0.1:3000

# 凭据加密主密钥（AES-256-GCM 加密 Credential 表）。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 不设：开发模式凭据明文落库（启动 warn）；生产模式拒绝启动。
# 丢失后已加密凭据无法解密；更换需重新录入凭据。
# CREDENTIAL_MASTER_KEY=

# ===== Web / Next.js =====
# Next.js rewrite 反代目标（Tunnel / 远程 dev 时可改）
# SERVER_INTERNAL_URL=http://127.0.0.1:3010
# NEXT_PUBLIC_SERVER_URL=http://127.0.0.1:3010
# About 页 profile 绝对路径（可选；默认 content/about/profile.md）
# ABOUT_PROFILE_PATH=D:/ALL IN AI/OasisMind/content/about/profile.md
# Web 绑 0.0.0.0（pnpm remote 内部使用）
# WEB_HOST=0.0.0.0

# ===== Cloudflare Tunnel（可选）=====
# CLOUDFLARE_TUNNEL_TOKEN=eyJh...
# PUBLIC_URL=https://oasismind.yourdomain.com
# 设置 PUBLIC_URL 时：生产环境必须 AUTH_MODE=password（否则 server 拒绝启动）；
# 开发环境仅 warn。隧道脚本 pnpm remote / dev:ngrok 无鉴权一律拒绝。
# OM_REQUIRE_PUBLIC_AUTH=1  # 开发也强制拒启
# OM_ALLOW_INSECURE_PUBLIC=1  # 显式逃生（不安全）

# ===== 启动日志 =====
# 默认只打必要信息（监听地址、安全告警、IM/邮件一行摘要、freeKeys 结果、真实失败）
# OM_VERBOSE_BOOT=1  # 白名单细则 / OCR 链 / Browser 预热 / 调度器挂载 / freeKeys 远程 404 / NapCat 明细等
# OM_VERBOSE_SYNC=1  # db:sync / sync:watch 逐实体扫描明细（默认一行摘要）
# ONEBOT_VERBOSE=1   # NapCat 配置生成 / attach 探测过程

# ===== 能力包 Core+Packs（轻量化）=====
# 详见 config.yaml packs:；此处 env 优先于 yaml
# OM_PACKS=full          # 全开（默认，与现网一致）
# OM_PACKS=lite          # 仅 core+chat：花园 + Chat，无 Swarm/IM/邮件/浏览器预热/研究/viz
# OM_PACKS_DISABLE=viz,research   # 在 full 上关掉列出的包
# OM_PACKS_ENABLE=im              # 在 lite 上点开列出的包


# ===== 可选鉴权（L5-M03）=====
# 默认 none：本地单用户无登录；password：控制台需 Bearer Token
# 公网 / 隧道（pnpm remote、pnpm dev:ngrok）强制 password，否则拒绝启动
# AUTH_MODE=none
# AUTH_MODE=password
# AUTH_PASSWORD=your-secure-password
# AUTH_TOKEN=  # 可选；不设则与 AUTH_PASSWORD 相同

# ===== 速率限制（P2）=====
# 本地 loopback 默认跳过全局限流（Chat 多 query/SSE 易误触 429 → 前端假报「后端未连接」）
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_SKIP_LOCALHOST=true   # false=本机也限流（仅调试）
# RATE_LIMIT_GLOBAL_PER_15MIN=3000
# RATE_LIMIT_STREAM_PER_MIN=60

# ===== Agent / LLM =====
# LLM_DEFAULT_PROVIDER=deepseek
# DEFAULT_LLM_MODEL=deepseek-v4-flash  # 全局默认模型 id（覆盖 config.yaml llm.defaultModel）
# LLM_DAILY_BUDGET=10
# LLM_BLENDED_USD_PER_1K=0.0001  # 本地日预算粗算单价（USD/1K tokens，默认≈$0.10/1M）；≠真实账单；:free/本地不计美元
# REQUIRE_APPROVAL=true
# AGENT_MAX_TOOL_ROUNDS=12
# AGENT_MAX_TOOL_CALLS_PER_RUN=168
# AGENT_TOOL_CALL_TIMEOUT_MS=30000
# AGENT_TOOL_CALL_CONCURRENCY=2
# AGENT_DESTRUCTIVE_APPROVAL=false  # true 时 Agent/tRPC 删除类操作走审批（memory/post/file 等）
# AGENT_TOOL_SCHEMA_HARD_CAP_BYTES=500000  # 工具 schema 硬顶（字节，默认 500KB）；超限先剥集成/skill/mcp，仍超拒跑
# APPROVAL_PENDING_TTL_MS=86400000  # pending 审批过期毫秒，默认 24h；0=关闭 TTL

# ===== Swarm =====
# SWARM_MODE=local          # local（默认，零依赖）| redis（分布式锁 + BullMQ SwarmBus，需 Redis）
# REDIS_URL=redis://127.0.0.1:6379
# AGENT_MAX_SUBAGENTS_PER_SESSION=10
# （AGENT_DESTRUCTIVE_APPROVAL / APPROVAL_PENDING_TTL_MS 见上方 Agent / LLM 段）

# ===== 通知 / 邮件 =====
# EMAIL_PROVIDER=agentmail | smtp | ntfy | none
# 可叠加：配了 NTFY_TOPIC 时，无论 EMAIL_PROVIDER 是 agentmail/smtp，都会额外推 ntfy
#
# --- AgentMail（问人 + 可发通知；Free≈3000封/月）---
# EMAIL_PROVIDER=agentmail
# EMAIL_TO=your@qq.com
# AGENTMAIL_API_KEY=
# AGENTMAIL_INBOX_ID=yourname@agentmail.to
# AGENTMAIL_ASK_TO=your@qq.com
# 探测：pnpm email:test  或  /settings →「发送测试邮件」
# AGENTMAIL_WEBHOOK_SECRET=
# AGENTMAIL_WEBHOOK_URL=https://<tunnel>/api/webhooks/agentmail  # 可选；缺省由 PUBLIC_URL 派生
# 本机 webhook：https://<tunnel>/api/webhooks/agentmail（需 Cloudflare Tunnel / ngrok 暴露公网，localhost 不可达）
#
# --- ngrok 固定公网域名（推荐：免费 dev domain，永久固定，邮件 webhook 稳定）---
# 1. 注册 ngrok 免费账号 → dashboard 领一个 dev domain（如 xxx.ngrok-free.dev）
# 2. ngrok config add-authtoken <your-authtoken>
# 3. 填下面两项，pnpm dev:ngrok 启动 ngrok + dev，server 自动注册 AgentMail webhook
# NGROK_DOMAIN=xxx.ngrok-free.dev
# PUBLIC_URL=https://xxx.ngrok-free.dev
#
# --- QQ SMTP（单向邮件通知）---
# EMAIL_PROVIDER=smtp
# EMAIL_TO=2635495642@qq.com
# EMAIL_SMTP_HOST=smtp.qq.com
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_SECURE=true
# EMAIL_SMTP_USER=2635495642@qq.com
# EMAIL_SMTP_PASS=                    # QQ 邮箱「授权码」，不是登录密码
#
# --- ntfy.sh（免注册手机推送；topic 当密码，用长随机串）---
# NTFY_TOPIC=om-your-long-random-topic
# NTFY_SERVER=https://ntfy.sh
# NTFY_PRIORITY=default
# NTFY_TOKEN=                         # 可选；自建 ntfy 才需要
#
# ASK_USER_FIRST_REMINDER_MS=600000
# ASK_USER_REPEAT_REMINDER_MS=3600000
# ASK_USER_TTL_MS=86400000

# ===== 全局代理（国内访问国外 LLM / 站点，可选）=====
# ===== Global HTTP(S) proxy (optional; for LLM / overseas sites from CN) =====
# 中文：Node 全局 fetch（undici）默认不读系统代理。设置下列任一变量后，server 启动时
#       使用 EnvHttpProxyAgent：外网走代理，本机地址直连。
# EN: Node global fetch ignores OS proxy by default. Any of the vars below installs
#     EnvHttpProxyAgent: proxied for public hosts, direct for loopback.
# 优先级 / Priority: OM_HTTPS_PROXY > HTTPS_PROXY > HTTP_PROXY > OM_HTTP_PROXY
# HTTPS_PROXY=http://127.0.0.1:7890
# OM_HTTPS_PROXY=http://127.0.0.1:7890
#   中文：OasisMind 专用代理（推荐，避免污染其他工具的 HTTPS_PROXY）
#   EN: OasisMind-only proxy (preferred over shell-wide HTTPS_PROXY)
# NO_PROXY=localhost,127.0.0.1,::1,.local
#   中文：本机绕过列表（必含 127.0.0.1）。否则 OneBot→NapCat 被 Clash 拐走 → HTTP 502，QQ 只进不出
#   EN: Loopback bypass list (must include 127.0.0.1). Otherwise OneBot hits Clash → 502, QQ receive-only

# ===== AI Providers =====
# 服务端读取（改 .env 后须重启 pnpm dev:server）
# Mock LLM 服务（本地测试，省钱稳定）：pnpm start:mock-llm 启动 http://localhost:3040
#   切换：把对应厂商 baseUrl 指向 mock 服务，API Key 随便填，无需 MOCK_LLM=true
#   DEEPSEEK_BASE_URL=http://localhost:3040/v1
#   错误注入（请求 header）：x-mock-fail=429|500|401|timeout|network|overflow, x-mock-delay-ms=500, x-mock-stream-break=after-5
# DEEPSEEK_API_KEY=          # 与 VITE_DEEPSEEK_API_KEY 二选一即可
# VITE_DEEPSEEK_API_KEY=     # 兼容旧写法，仅 server 启动时 loadRootEnv 加载
# DEEPSEEK_MODEL=deepseek-v4-flash   # 默认模型；legacy deepseek-chat 会被此值覆盖
# VITE_DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=        # 配置后同步官方 :free 模型目录，并路由 *:free 模型到 OpenRouter
# OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ===== 本地模型（OpenAI 兼容；无需真实 API Key）=====
# 会话 / Agent 的 model 请用「厂商前缀」：ollama/<name>、llamacpp/<name>、lmstudio/<name>、vllm/<name>
# Chat 模型菜单 →「本地模型」会探测本机已加载列表（llm.listLocalModels）
# 全站默认走本地示例：
#   LLM_DEFAULT_PROVIDER=ollama
#   DEFAULT_LLM_MODEL=ollama/llama3.2
# Ollama（默认 http://127.0.0.1:11434/v1；也可用原生 /api/tags 发现模型）
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2
# OLLAMA_API_KEY=local
# llama.cpp server（./llama-server -m model.gguf --port 8080）
# LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
# LLAMACPP_MODEL=local
# LM Studio 本地服务（默认 1234）
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LMSTUDIO_MODEL=local
# vLLM（python -m vllm.entrypoints.openai.api_server --port 8000）
# VLLM_BASE_URL=http://127.0.0.1:8000/v1
# VLLM_MODEL=local
# 可选：本地失败后降级到云端（需对应云厂商 Key）
# 在 config.yaml：llm.fallbackModels: ["deepseek-v4-flash"]
# ===== 免费 API Key 自动同步（默认开启，server 启动即跑）=====
# FREE_KEYS_AUTO_SYNC=true   # 设 0/false 关闭
# FREE_KEYS_SYNC_INTERVAL_MS=3600000
# FREE_KEYS_PROXY=https://ghproxy.net/   # 国内拉 raw.githubusercontent.com 可选代理
# FREE_KEYS_LOCAL_FILE=data/free-keys-readme.md  # GitHub 源失败时本地 README 兜底
# FREE_KEYS_SKIP_PROBE=false # true 时跳过探活（仅解析入库）

# KIMI_API_KEY=
# VITE_KIMI_API_KEY=
# ZHIPU_API_KEY=

# ===== Search（web_search — MetaBlog smartSearch 多引擎）=====
# 引擎优先级（逗号分隔）。未设置且已配置 Tavily/SerpAPI 时，自动为 bing_crawler,tavily,serpapi,duckduckgo,...
# SEARCH_ENGINE_PRIORITY=bing_crawler,duckduckgo,baidu_qianfan,tavily,serpapi
# 本地/自托管 SearXNG 实例（轻量、免费、无需 API Key）：docker compose --profile searxng up -d
# 配置后自动优先使用本地实例，失败再回退公共实例。示例：http://127.0.0.1:8080
# SEARXNG_URL=
# SEARCH_BAIDU_QIANFAN_API_KEY=
# SEARCH_METASO_API_KEY=
# SEARCH_BOCHA_API_KEY=
# SEARCH_LANGSEARCH_API_KEY=
# SEARCH_TAVILY_API_KEY=
# SEARCH_BRAVE_API_KEY=
# SEARCH_BING_API_KEY=
# SEARCH_SERPAPI_API_KEY=

# ===== Literature（literature_search / literature_get）=====
# OpenAlex 礼貌池：填真实邮箱更好（可与 LITERATURE_CONTACT_EMAIL 二选一）
# OPENALEX_MAILTO=you@example.com
# LITERATURE_CONTACT_EMAIL=you@example.com
# Semantic Scholar 可选（提高限额）：Credential scope=semantic_scholar name=api_key 或：
# SEMANTIC_SCHOLAR_API_KEY=

# ===== 知乎数据开放平台（推荐；Inbox 收藏同步优先走此通道）=====
# 在 https://developer.zhihu.com/ 登录 → 个人中心申请 Token（Access Secret）
# 申请后仅显示一次，丢失可删除重申
# ZHIHU_ACCESS_SECRET=
# ZHIHU_OPENAPI_BASE_URL=https://developer.zhihu.com

# ===== 网页读取（read_article — 知乎 Cookie 可选，无开放平台 key 时的回退）=====
# 浏览器 F12 → Application → Cookies → 复制 z_c0 等，格式 name=value; name2=value2
# ZHIHU_COOKIE=z_c0=...; _xsrf=...
# 微信 read_article 可选 Cookie / 冒烟 URL（integration:smoke:platform）
# WECHAT_COOKIE=...
# WECHAT_SMOKE_URL=https://mp.weixin.qq.com/s/...
# XHS_COOKIE=...   # 或 XIAOHONGSHU_COOKIE
# XHS_SMOKE_URL=https://www.xiaohongshu.com/explore/...
# DOUYIN_COOKIE=...
# DOUYIN_SMOKE_URL=https://www.douyin.com/video/...
# JUEJIN_SMOKE_URL=https://juejin.cn/post/...
# INFOQ_SMOKE_URL=https://www.infoq.cn/article/...
# CSDN_SMOKE_URL=https://blog.csdn.net/.../article/details/...
# SEGMENTFAULT_SMOKE_URL=https://segmentfault.com/a/1190000046145001
# OSCHINA_SMOKE_URL=https://www.oschina.net/news/291686/deepseek-v3
# CNBLOGS_SMOKE_URL=https://www.cnblogs.com/metaz/p/16798692.html
# JIANSHU_SMOKE_URL=https://www.jianshu.com/p/5a35a61bad8f
# 快速平台冒烟（仅 B站/掘金/CSDN）：pnpm integration:smoke:platform:quick
# medium（7 站）：pnpm integration:smoke:platform:medium
# extended（+博客园/简书，9 站）：pnpm integration:smoke:platform:extended

# Playwright 共享浏览器预热（默认开启；设为 0 可关闭以加快冷启动）
# BROWSER_WARMUP=0

# ===== OCR（Chat 非多模态发图 — PaddleOCR 本地 + OCR.space 降级）=====
# CLI 默认: tools/ocr/paddleocr_cli.py  权重: weights/ocr/paddleocr/  复制: pnpm ocr:copy
# PADDLEOCR_CLI_PATH=
# PADDLEOCR_PYTHON_PATH=d:\python-envs\baseenv\Scripts\python.exe
# PPOCR_HOME=weights/ocr/paddleocr
# OCR_SPACE_API_KEY=
# OCR_SPACE_DEFAULT_LANG=chs

# ===== 本地语音转文字 STT（Whisper；视频笔记 — 不是 TTS）=====
# 一次安装：pip install -U faster-whisper yt-dlp ；并确保 ffmpeg 在 PATH
# STT_PYTHON_PATH=D:\ALL IN AI\OasisMind\.venv\Scripts\python.exe   # 推荐：项目 uv venv
# STT_WHISPER_MODEL=small         # 推荐 small；也可 tiny | base（越大切越慢）
# STT_LANGUAGE=zh
# STT_YT_DLP_PATH=D:\ALL IN AI\OasisMind\.venv\Scripts\yt-dlp.exe
# uv 装包慢可加清华源：uv pip install -U faster-whisper yt-dlp -i https://pypi.tuna.tsinghua.edu.cn/simple
# 或永久：uv pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple
# STT_TIMEOUT_MS=600000           # 单次转写超时；同步工具仍受 AGENT_TOOL_CALL_TIMEOUT_MS 约束
# STT_DOWNLOAD_TIMEOUT_MS=600000
# STT_MAX_DURATION_SEC=1200       # yt-dlp 最长秒数（默认 20 分钟）
# 长视频请让 Agent 用 async_task_run 跑 media_download / audio_transcribe / video_notes
# AGENT_TOOL_CALL_TIMEOUT_MS=300000  # 若坚持同步转写，可临时加大（默认 30s 会掐断）

# ===== 外挂视觉理解器（vision_describe 工具 — 纯文本模型外挂免费多模态看图）=====
# 默认模型选择顺序（国内优先、免费优先）：
#   1) VISION_DESCRIBE_MODEL 显式覆盖
#   2) 当前 Agent 模型若支持 vision → 复用
#   3) 智谱 ZHIPU_API_KEY → glm-4.1v-thinking-flash（免费、国内直连、无需代理）★ 国内首选
#   4) Kimi KIMI_API_KEY → kimi-k2.5（注册送免费额度、国内直连）
#   5) Gemini GEMINI_API_KEY → gemini-2.0-flash（国外，国内需代理）
#   6) OpenRouter → google/gemma-4-26b-a4b-it:free（国外，需代理）
#   7) deepseek-vl2 兜底（付费）
# 国内无 gemini/不想翻墙：去 https://open.bigmodel.cn 注册拿 ZHIPU_API_KEY（免费层），只配这一项即可。
# 显式覆盖示例：
# VISION_DESCRIBE_MODEL=glm-4.1v-thinking-flash
# VISION_DESCRIBE_MODEL=kimi-k2.5

# ===== Dokobot（真实 Chrome 读网页，本地免费）=====
# Agent 工具 dokobot_read / dokobot_search 调用本机 CLI。
# 一次性安装：Chrome 扩展 https://dokobot.ai/install → npm i -g @dokobot/cli → dokobot install-bridge
# 保持 Chrome 打开；本地模式无需 API Key。未安装时工具返回 installHint，Agent 会回退 read_article。
# DOKOBOT_BIN=dokobot
# Remote 模式（可选，需扩展 Remote Control + API Key）：
# DOKO_API_KEY=

# ===== Kimi WebBridge（真实浏览器点击/填表，本机 daemon）=====
# 工具：webbridge_status / webbridge_start / webbridge_command（元工具 POST /command）。
# 安装：https://www.kimi.com/zh-cn/features/webbridge → 扩展 Connected；daemon 默认 ~/.kimi-webbridge/bin/
# WEBBRIDGE_URL=http://127.0.0.1:10086
# WEBBRIDGE_BIN=  # 可选；默认 %USERPROFILE%\.kimi-webbridge\bin\kimi-webbridge.exe

# ===== 学术 / HuggingFace Hub（search_arxiv / search_huggingface 等）=====
# arXiv 走 export.arxiv.org，一般国内可直连。
# HuggingFace 官方站国内常超时；可改镜像（推荐 hf-mirror）：
# HF_ENDPOINT=https://hf-mirror.com
# HF_HUB_DISABLE_XET=1
# 与 PPOCR 并列：项目内 HF 缓存（避免落到 D:\DevCache 或用户目录）
# HF_HOME=D:\ALL IN AI\OasisMind\weights\hf
# HUGGINGFACE_HUB_CACHE=D:\ALL IN AI\OasisMind\weights\hf\hub
# 预拉 Whisper small（faster-whisper，约 460MB；只保留这一档即可）：
#   $env:HF_HOME="...\weights\hf"; $env:HUGGINGFACE_HUB_CACHE="...\weights\hf\hub"
#   $env:HF_ENDPOINT="https://hf-mirror.com"; $env:HF_HUB_DISABLE_XET="1"
#   .\.venv\Scripts\python.exe -c "from faster_whisper.utils import download_model; print(download_model('small'))"
# STT_WHISPER_MODEL=small
# HF_ENDPOINT=https://huggingface.co

# ===== 异步 Agent 后台任务 =====
# AGENT_ASYNC_MAX_CONCURRENT=2
# AGENT_ASYNC_MAX_PER_SESSION=2
# AGENT_ASYNC_MAX_LIGHTWEIGHT=2         # 纯工具/Playwright 并发（与 LLM 槽正交）
# AGENT_ASYNC_TASK_TIMEOUT_MS=300000
# AGENT_ASYNC_QUEUED_TIMEOUT_MS=0       # 排队超时（0=不超时）

# ===== PinMe（静态站公网部署，Agent 工具 pinme_upload）=====
# 官网 https://pinme.eth.limo/ ；也可用凭据 scope=pinme name=appkey
# PINME_APPKEY=

# ===== Shell（run_shell 工具 — 默认关闭，须显式开启）=====
# run_shell 为 destructive（native:all 默认隐藏；AGENT_DESTRUCTIVE_APPROVAL=true 时走审批）
# cwd 沙箱为 Agent Workspace（无则 data/workspace），不再默认项目根
# SHELL_ENABLED=true
# SHELL_MODE=host_restricted
# docker 模式：命令进容器执行（需本机 docker；镜像可用 SHELL_DOCKER_IMAGE 覆盖，默认 node:22-bookworm-slim）
# SHELL_MODE=docker
# SHELL_DOCKER_IMAGE=node:22-bookworm-slim
# SHELL_TIMEOUT_MS=30000
# SHELL_MAX_OUTPUT_CHARS=12000
# SHELL_BINARY=auto
#
# 主机目录 / 桌面（QQ·微信远程助手）：config.yaml hostAccess（总闸 + roots）
# 不是 SHELL_MODE=host_full。群聊拒绝。Windows-MCP：uvx --python 3.12 windows-mcp serve（系统 Python 3.10 不够）

# ===== CosyVoice TTS（文本→语音；与上面 STT「语音→文字」相反）=====
# 用途：qq-bot 的 voice_list / voice_clone / voice_synthesize / send_qq_voice（合成模式）
# 授权：仅 config/agents/qq-bot.md 默认勾选；其它 Agent 不会自动带这些工具
# 控制台：https://bailian.console.aliyun.com/ → API-KEY（北京区即可）
# 参考音（本机，勿删）：workspaces/daily-fragments/voice-clones/hikari-ultraman-seiyuu/reference/
#   hikari_ishigawa_masa.wav  = 石川真（希卡利主样本）
#   hikari_nanbo_keiichi.wav  = 难波圭一（旧混音用，已弃用混音音色）
#
# —— API Key（按优先级，命中第一个非空且非占位符的）——
#   1) COSYVOICE_API_KEY   ← 推荐：百炼专用，格式通常 sk- 或 sk-ws-…
#   2) DASHSCOPE_API_KEY   ← 与百炼同一套 Key 也可写这里
#   3) TTS_API_KEY         ← 通用别名；必须是百炼 Key，禁止填别家 sk_…（会 401）
#   4) VITE_QWEN_API_KEY   ← 最后兜底；占位 your-api-key-here 会被忽略
# COSYVOICE_API_KEY=
# DASHSCOPE_API_KEY=
# TTS_API_KEY=
#
# TTS_PROVIDER=cosyvoice
#   当前唯一实现；其它值会报错
#
# TTS_COSYVOICE_MODEL=cosyvoice-v3-flash
#   克隆与合成必须用同一模型；voice_clone 的 target_model 默认也读这个
#   要「愤怒/温柔」等语气：必须用 cosyvoice-v3-flash 或 cosyvoice-v3.5-*（v3-plus 复刻不支持 instruction）
#
# TTS_LANGUAGE=ja
#   默认合成语种提示：只认 ja / zh / en 等短码；不要写 ja-JP（会回退中文腔）
#
# TTS_VOICE=
#   默认克隆音色 voice_id（voice_list / voice_clone 返回的长串）
#   希卡利须与上面 MODEL 同系列（flash 的 voice_id 不能拿去 v3-plus 合成）
#   可空：工具参数显式传 voice=… 即可
#
# TTS_SPEED=1.0
#   默认语速，范围约 0.5～2.0；工具参数 rate 可覆盖
#
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
#   北京区默认；新加坡等国际站才需改（如 https://dashscope-intl.aliyuncs.com/api/v1）
#
# 常用调用（QQ 绑定会话可省略目标）：
#   send_qq_voice({ provider:"cosyvoice", text:"…", language:"ja", tone:"gentle" })
#   官方可调：rate/pitch/volume/seed/format/sample_rate/bit_rate(opus)/enable_ssml/
#            hot_words/enable_markdown_filter/enable_aigc_tag/tone/dialect/instruction
#   tone 预设只是糖衣；instruction 可写任意自然语言（方言/情感/角色，≤100 计费字符）
#   注意：带 tone/instruction 时服务端不会再传 language_hints（同传会导致语气失效）
#   文档：https://help.aliyun.com/zh/model-studio/cosyvoice-tts-http-api

# ===== Integrations（可选）=====
# GITHUB_TOKEN=
# YUQUE_SESSION=
# YUQUE_CTOKEN=
# YUQUE_TOKEN=
# FEISHU_TENANT_ACCESS_TOKEN=
#
# SwanLab（深度学习实验跟踪，类似 W&B；工具 swanlab_*）
# 安装：pip install -U swanlab ；密钥：https://swanlab.cn → 设置 → API Key
# 也可用 Credential(scope=swanlab, name=api_key)
# SWANLAB_API_KEY=
# SWANLAB_API_HOST=   # 可选；私有化部署时填写

# ===== IM 通道（QQ / 飞书，可选）=====
# ===== IM channels (QQ / Feishu, optional) =====
#
# QQ 开放平台官方 Bot — 手机指挥家里 Agent（推荐）
# Official QQ Open Platform Bot — phone remote control for home Agent (recommended)
# 1) https://q.qq.com/ 建 Bot，开通单聊 + 群聊@机器人事件；2) 填 AppID/Secret；3) 家里用 WS（无需公网）
# QQ_BOT_APP_ID=
# QQ_BOT_SECRET=
# QQ_BOT_ALLOWED_OPENIDS=   # 账号白名单：openid 或 QQ 号；空=拒所有；*=临时全开
# QQ_BOT_QQ_OPENID_MAP=     # QQ号=openid；同一号私聊/群聊 openid 常不同：2251061018=c2cOpenId|groupOpenId
# QQ_BOT_ALLOWED_GROUPS=    # 群白名单：空=拒一切群；*=任意群；可填群号或 group_openid
# QQ_BOT_GROUP_OPENID_MAP=  # 群号=group_openid（事件里常是 openid，沙箱填的是数字群号）
# QQ_BOT_GROUP_HISTORY_LIMIT=40  # 未@的群消息环形缓冲条数；0=关闭；@时拼进上下文再起流
# QQ_BOT_WS=true            # 家里推荐 true：本机出站连官方网关；false 则走 webhook（需公网 → /api/webhooks/qq）
# QQ_BOT_ENABLED=true
# QQ_BOT_THINKING_TXT_CHARS=3500  # 思考超过此字数才改发 .txt；短于则发「【思考过程】」文本
# QQ_BOT_ANSWER_MAX_CHARS=4500    # 正式回复纯文本上限
# 说明：平台「被动回复」msg_id 时效约群 5min / 私聊 60min——超时不能再带 msg_id，但**主动消息仍可发**。
#       见微默认主动出站；过期自动去掉 msg_id。长任务无需重启服务。本地缓存 24h 仅记 peer。
# 群「全部上下文」：手机 QQ → 群设置 → 机器人 →「可获取的群聊消息范围」= 获取群内全部消息
# （Webhook 还须勾选 GROUP_MESSAGE_CREATE；WS 已订 1<<25。未开则平台不推非@，缓冲永远空）

# NapCat / OneBot 已退役（勿再配置 ONEBOT_*；pnpm napcat 为空壳；不会发掉线邮件）
ONEBOT_ENABLED=false

# 飞书机器人双向：@机器人 → 本机会话 → 同线程回帖
# 飞书开放平台 → 事件订阅 → 请求地址 https://<公网>/api/webhooks/feishu
# 订阅 im.message.receive_v1；权限 im:message / im:message:send_as_bot
# FEISHU_APP_ID=          # 也可沿用文档集成同一应用
# FEISHU_APP_SECRET=
# FEISHU_BOT_VERIFICATION_TOKEN=   # 必填：事件订阅 Verification Token（未设则 webhook 硬拒）
# FEISHU_ENCRYPT_KEY=              # 可选：Encrypt Key；配置后验签+解密；收到 encrypt 未配则硬拒
# FEISHU_BOT_ALLOWED_OPENIDS=      # 可选白名单 open_id，逗号分隔；空=拒绝所有人，*=允许所有人
# FEISHU_BOT_ENABLED=true
# 审批「待你点头」通知扇出到飞书（open_id 或 oc_ 开头的 chat_id）
# FEISHU_APPROVAL_NOTIFY_OPEN_ID=

# WeChat ClawBot (official iLink). Do NOT run openclaw-weixin-cli in this repo.
# Phone: Me -> Settings -> Plugins -> ClawBot, then scan QR on /channels.
# Text / image / voice / video inbound+outbound. Session: data/weixin-clawbot/session.json
# WEIXIN_CLAWBOT_ENABLED=true
# WEIXIN_CLAWBOT_ALLOWED_USER_IDS=   # empty = first sender is bound; * = everyone (unsafe)
# WEIXIN_CLAWBOT_API_BASE=https://ilinkai.weixin.qq.com
