/**
 * A stand-in for `cursor-cua-sidecar.exe`, faithful to the parts of the client
 * handshake contract a POSIX host can exercise.
 *
 * It is a real child process listening on a real socket, so the client's
 * launch-provenance chain runs for real: the `listening on …` line arrives on
 * a stderr pipe owned by the client, `process.pid` in the welcome frame is
 * genuinely this process, and exiting genuinely makes the liveness check fail.
 * Only the transport differs — a Unix socket instead of a named pipe, which
 * `net.createConnection({ path })` dials identically.
 *
 * Usage: node fake-sidecar.cjs <socketPath> <tokenPath> [options-json]
 */

"use strict";

const { randomUUID } = require("node:crypto");
const fs = require("node:fs");
const net = require("node:net");

const [socketPath, tokenPath, optionsJson] = process.argv.slice(2);
const options = optionsJson ? JSON.parse(optionsJson) : {};

/**
 * The sidecar reads its token once at startup and fails closed when it is
 * missing, exactly like `run()` refusing to listen without a launch binding.
 */
let boundToken;
try {
	boundToken = fs.readFileSync(tokenPath, "utf8").trim();
} catch {
	process.stderr.write(
		"cursor-cua-sidecar: refusing to listen without a launch binding: no token file\n"
	);
	process.exit(1);
}

if (options.squatted) {
	process.stderr.write(
		`cursor-cua-sidecar: failed to create pipe ${socketPath} (possible squatter): name in use\n`
	);
	process.exit(1);
}

const reportedPid =
	typeof options.reportPid === "number" ? options.reportPid : process.pid;

// Admit this many handshakes, then deny the rest. Lets a test get past the
// launch-time ping into a live binding and only then be refused, which is the
// only way to reach the client's denial branch with a bound sidecar.
// Delay exiting on SIGTERM by this many ms, to exercise the retirement bound:
// the fixture normally dies in microseconds, so any non-zero wait passes and
// "waited for exit" is indistinguishable from "gave up".
if (typeof options.exitDelayMs === "number") {
	process.on("SIGTERM", () => {
		setTimeout(() => process.exit(0), options.exitDelayMs);
	});
}

const denyAfter =
	typeof options.denyAfter === "number" ? options.denyAfter : Infinity;
let admittedCount = 0;

const server = net.createServer(connection => {
	let buffered = "";
	let admitted = false;
	connection.setEncoding("utf8");
	connection.on("data", chunk => {
		buffered += chunk;
		let newlineIndex = buffered.indexOf("\n");
		while (newlineIndex >= 0) {
			const line = buffered.slice(0, newlineIndex);
			buffered = buffered.slice(newlineIndex + 1);
			newlineIndex = buffered.indexOf("\n");
			if (!admitted) {
				// Contract step 3: the handshake is the first line on every
				// connection, and nothing reaches the RPC dispatcher first.
				if (!acceptHandshake(connection, line)) {
					return;
				}
				admitted = true;
				continue;
			}
			handleRpc(connection, line);
		}
	});
	connection.on("error", () => { });
});

function acceptHandshake(connection, line) {
	process.stderr.write(`cursor-cua-sidecar: handshake line ${line.length}b\n`);
	let frame;
	try {
		frame = JSON.parse(line);
	} catch {
		return deny(connection);
	}
	if (
		options.rejectAll ||
		admittedCount >= denyAfter ||
		frame.cua !== "hello" ||
		frame.version !== 1 ||
		typeof frame.token !== "string" ||
		frame.token !== boundToken
	) {
		return deny(connection);
	}
	admittedCount += 1;
	connection.write(
		`${JSON.stringify({ cua: "welcome", version: 1, pid: reportedPid })}\n`
	);
	return true;
}

function deny(connection) {
	// One generic reason for every cause, as the sidecar does.
	connection.write(
		`${JSON.stringify({ cua: "denied", reason: "handshake rejected" })}\n`
	);
	connection.end();
	return false;
}

function handleRpc(connection, line) {
	let request;
	try {
		request = JSON.parse(line);
	} catch {
		connection.write(`${JSON.stringify({ id: null, error: "bad json" })}\n`);
		return;
	}
	// Every request's method (and tool name) as one JSON line, so a test can
	// see what went on the wire and when — the keep-alive pings included.
	if (typeof options.requestLog === "string") {
		fs.appendFileSync(
			options.requestLog,
			`${JSON.stringify({
				at: Date.now(),
				method: request.method,
				name: request.name,
				timeoutSeconds: request.timeoutSeconds,
				deadlineEpochSeconds: request.deadlineEpochSeconds,
			})}\n`
		);
	}
	if (request.method === "ping") {
		connection.write(`${JSON.stringify({ id: request.id, ok: true })}\n`);
		return;
	}
	if (
		request.method === "control/start" ||
		request.method === "control/release"
	) {
		handleLease(connection, request);
		return;
	}
	process.stderr.write(
		`cursor-cua-sidecar: tools/call ${String(request.name)}\n`
	);
	// How a tools/call is answered, for the client's refusal classification.
	// Each option mirrors one thing the real sidecar (or a broken one) does.
	if (options.dropAfterRequest) {
		// Read the request, then hang up without answering: the shape of a
		// sidecar crash mid-action, after the input may have been synthesized.
		connection.destroy();
		return;
	}
	if (options.garbageAfterRequest) {
		connection.write("this is not a response\n");
		return;
	}
	if (typeof options.oversizedAfterRequest === "number") {
		// A reply larger than the client accepts, with no newline so it can
		// only ever be rejected on size: the sidecar ran the tool and then
		// answered with more than the framing allows.
		connection.write(Buffer.alloc(options.oversizedAfterRequest, 0x78));
		return;
	}
	if (options.envelope) {
		// A refusal before any tool runs, in the envelope's error arm with the
		// code beside the message, as `RpcResponse::refusal` writes it.
		connection.write(
			`${JSON.stringify({
				id: request.id,
				error: options.envelope.message,
				errorCode: options.envelope.code,
				escalation: {
					recommended: options.envelope.recommended ?? "retry",
					reason: options.envelope.reason ?? "fixture reason",
				},
			})}\n`
		);
		return;
	}
	if (options.refuse) {
		// A refused result, as `ToolResult::refusal` writes it: the message the
		// model always saw, plus the code and hint in structuredContent.
		connection.write(
			`${JSON.stringify({
				id: request.id,
				result: {
					message: options.refuse.message,
					structuredContent: {
						tool: request.name,
						status: "error",
						message: options.refuse.message,
						code: options.refuse.code,
						escalation: {
							recommended: options.refuse.recommended ?? "ask_user",
							reason: options.refuse.reason ?? "fixture reason",
						},
						error: { type: "operation_failed" },
					},
					isError: true,
				},
			})}\n`
		);
		return;
	}
	if (typeof options.legacyError === "string") {
		// A sidecar that predates the refusal codes: prose, no structure.
		connection.write(
			`${JSON.stringify({
				id: request.id,
				result: { message: options.legacyError, isError: true },
			})}\n`
		);
		return;
	}
	connection.write(
		`${JSON.stringify({
			id: request.id,
			result: {
				message: JSON.stringify({
					name: request.name,
					arguments: request.arguments,
					mode: request.mode,
				}),
				isError: false,
			},
		})}\n`
	);
}

/**
 * The remote-control lease, as `sys/mod.rs` answers it: `control/start` is
 * `ok` plus a fresh v4 `sessionId`, `control/release` is a plain `ok`. Each
 * lease request is appended to `options.leaseLog` (one JSON line each) so a
 * test can see exactly what went on the wire. With `options.noLease` the
 * fixture plays a sidecar that predates the lease and refuses both methods
 * the way `route()` refuses an unknown one.
 */
function handleLease(connection, request) {
	if (typeof options.leaseLog === "string") {
		fs.appendFileSync(options.leaseLog, `${JSON.stringify(request)}\n`);
	}
	if (options.noLease) {
		connection.write(
			`${JSON.stringify({
				id: request.id,
				error: `Unknown RPC method: ${request.method}`,
				errorCode: "unsupported_request",
				escalation: {
					recommended: "ask_user",
					reason: "The client sent a request this sidecar cannot serve.",
				},
			})}\n`
		);
		return;
	}
	if (request.method === "control/start") {
		connection.write(
			`${JSON.stringify({
				id: request.id,
				ok: true,
				sessionId: randomUUID(),
			})}\n`
		);
		return;
	}
	connection.write(`${JSON.stringify({ id: request.id, ok: true })}\n`);
}

// Windows releases a pipe name when its owner exits; a Unix socket leaves the
// path behind, so clear it to keep the emulation faithful across relaunches.
fs.rmSync(socketPath, { force: true });

server.listen(socketPath, () => {
	// Printed only once the name is genuinely ours, mirroring the sidecar
	// printing this after CreateNamedPipeW(FILE_FLAG_FIRST_PIPE_INSTANCE).
	process.stderr.write(`cursor-cua-sidecar: listening on ${socketPath}\n`);
});

server.on("error", error => {
	process.stderr.write(`cursor-cua-sidecar: accept failed: ${error.message}\n`);
	process.exit(1);
});
