df_europe['Tourism Growth (YoY %)'])\nplt.title('Tourism Growth (YoY %) - Europe')\nplt.xlabel('City')\nplt.ylabel('Tourism Growth (YoY %)')\nplt.show()\n\n# --- 4) Bar Chart: Avg. Occupancy Rate (Europe) ---\nplt.bar(df_europe['City'], df_europe['Avg. Occupancy Rate (%)'])\nplt.title('Average Occupancy Rate (%) - Europe')\nplt.xlabel('City')\nplt.ylabel('Occupancy Rate (%)')\nplt.show()\n\n# --- 5) Bar Chart: Tourism Growth (Asia) ---\nplt.bar(df_asia['City'], df_asia['Tourism Growth (YoY %)'])\nplt.title('Tourism Growth (YoY %) - Asia')\nplt.xlabel('City')\nplt.ylabel('Tourism Growth (YoY %)')\nplt.show()\n\n# --- 6) Bar Chart: Avg. Occupancy Rate (Asia) ---\nplt.bar(df_asia['City'], df_asia['Avg. Occupancy Rate (%)'])\nplt.title('Average Occupancy Rate (%) - Asia')\nplt.xlabel('City')\nplt.ylabel('Occupancy Rate (%)')\nplt.show()\n"])</script><script>self.__next_f.push([1,"9a:[\"$\",\"$1\",\"3xaNZvz5mYw4l6QOdJYDf6\",{\"children\":[[\"$\",\"$L6a\",null,{\"moduleIds\":\"$74:props:children:1:props:children:1:props:children:props:children:1:props:children:1:props:tabs:0:content:props:children:0:props:moduleIds\"}],[\"$\",\"$L99\",null,{\"id\":\"3xaNZvz5mYw4l6QOdJYDf6\",\"conversations\":[{\"headline\":\"OpenAI o3\",\"messages\":[{\"variant\":\"input\",\"messageText\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"I own a boutique hotel chain with locations in Lisbon, Berlin, and London. I plan to expand into a new country in Europe, and a city in Asia, in 2026. What factors—such as tourism growth, seasonal occupancy patterns, and local economic indicators—best predict success? I want to be ahead of the curve and be in the next hot city before others. Pull regional travel data, economic statistics, and hotel occupancy rates; analyze trends visually and recommend ideal expansion locations.\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"autoExpandContext\":false,\"id\":\"5zVOmOvEalcEr7hbx9Ik