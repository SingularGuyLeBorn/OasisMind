          "type": "integer",
          "minimum": 0,
          "description": "Cost per batch of tokens"
        },
        "model": {
          "type": "string",
          "description": "Model responsible for this billing entry"
        },
        "tokenCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Total token count for this entry"
        },
