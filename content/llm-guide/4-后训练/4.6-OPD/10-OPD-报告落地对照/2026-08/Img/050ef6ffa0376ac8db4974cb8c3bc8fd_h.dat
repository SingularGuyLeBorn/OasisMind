n classified as medium risk in the Preparedness Framework, and we have incorporated commensurate safeguards and safety mitigations to prepare for this new model family. Our deployment of these models reflects our belief that iterative real-world deployment is the most effective way to bring everyone who is affected by this technology into the AI safety conversation.\"]}]]}]]}]]}]}]]}]}]\n"])</script><script>self.__next_f.push([1,"fb:[\"$\",\"div\",\"tVazvBfglkgvOtck3re1Q\",{\"className\":\"@md:mt-[3.5rem] mt-[2rem] @md:-mb-[2.5rem] -mb-[1.75rem]\",\"children\":[\"$\",\"$1\",\"tVazvBfglkgvOtck3re1Q\",{\"children\":[[\"$\",\"$L40\",null,{\"moduleIds\":\"$2f:props:children:3:props:children:props:children:0:props:moduleIds\"}],[\"$\",\"$L45\",null,{\"id\":\"tVazvBfglkgvOtck3re1Q\",\"text\":\"Appendix\",\"headlineStyleDefault\":\"Heading 3\",\"headlineTag\":\"h2\",\"omitFromTableOfContents\":false,\"__typename\":\"componentContentHeading\",\"contentfulDebugAttributes\":{},\"children\":\"$undefined\"}]]}]}]\nfc:[\"$\",\"div\",\"6qg6Th5ADR9ewiHjzL0Ec1\",{\"className\":\"@md:mt-[3.5rem] mt-[2rem] @md:-mb-[2.5rem] -mb-[1.75rem]\",\"children\":[\"$\",\"$1\",\"6qg6Th5ADR9ewiHjzL0Ec1\",{\"children\":[[\"$\",\"$L40\",null,{\"moduleIds\":\"$2f:props:children:3:props:children:props:children:0:props:moduleIds\"}],[\"$\",\"$L45\",null,{\"id\":\"6qg6Th5ADR9ewiHjzL0Ec1\",\"text\":\"Detailed safety evaluations\",\"headlineStyleDefault\":\"Heading 3\",\"headlineTag\":\"h3\",\"omitFromTableOfContents\":true,\"__typename\":\"componentContentHeading\",\"contentfulDebugAttributes\":{},\"children\":\"$undefined\"}]]}]}]\nfd:[\"$\",\"div\",\"5eI9xJ8ytitXmBI6yV8zVK\",{\"className\":\"\",\"children\":[\"$\",\"$1\",\"5eI9xJ8ytitXmBI6yV8zVK\",{\"children\":[[\"$\",\"$L40\",null,{\"moduleIds\":[113571]}],\"$L16d\"]}]}]\nfe:[\"$\",\"div\",\"3jmJCONR6Rk4PquMg5UX4m\",{\"className\":\"\",\"children\":[\"$\",\"$1\",\"3jmJCONR6Rk4PquMg5UX4m\",{\"children\":[[\"$\",\"$L40\",null,{\"moduleIds\":[278821]}]