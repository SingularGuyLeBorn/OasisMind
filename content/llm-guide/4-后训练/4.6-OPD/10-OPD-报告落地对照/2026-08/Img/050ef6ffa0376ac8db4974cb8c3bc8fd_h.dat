\",\"/_next/static/chunks/177n2_x52t3h2.js?dpl=dpl_4pprbRpM6o759okqyPapaAMa6Kqp\",\"/_next/static/chunks/1686l24ww7dph.js?dpl=dpl_4pprbRpM6o759okqyPapaAMa6Kqp\",\"/_next/static/chunks/0vp8umz6ehv~3.js?dpl=dpl_4pprbRpM6o759okqyPapaAMa6Kqp\",\"/_next/static/chunks/0kp_5z76rpb.v.js?dpl=dpl_4pprbRpM6o759okqyPapaAMa6Kqp\",\"/_next/static/chunks/0e6om322b6t60.js?dpl=dpl_4pprbRpM6o759okqyPapaAMa6Kqp\",\"/_next/static/chunks/0dlvmmfd_kboo.js?dpl=dpl_4pprbRpM6o759okqyPapaAMa6Kqp\",\"/_next/static/chunks/0-58akvfsy71..js?dpl=dpl_4pprbRpM6o759okqyPapaAMa6Kqp\",\"/_next/static/chunks/0gb6~n~9smf5l.js?dpl=dpl_4pprbRpM6o759okqyPapaAMa6Kqp\",\"/_next/static/chunks/0k~2ictx~3guv.js?dpl=dpl_4pprbRpM6o759okqyPapaAMa6Kqp\",\"/_next/static/chunks/0t.1ri-7_1rla.js?dpl=dpl_4pprbRpM6o759okqyPapaAMa6Kqp\",\"/_next/static/chunks/0xj_9pa07zqp5.js?dpl=dpl_4pprbRpM6o759okqyPapaAMa6Kqp\",\"/_next/static/chunks/0700mw7~o~wka.js?dpl=dpl_4pprbRpM6o759okqyPapaAMa6Kqp\",\"/_next/static/chunks/0fvo1_c20lltb.js?dpl=dpl_4pprbRpM6o759okqyPapaAMa6Kqp\",\"/_next/static/chunks/0isqt.dsm2sgc.js?dpl=dpl_4pprbRpM6o759okqyPapaAMa6Kqp\",\"/_next/static/chunks/0v3qq5fjxiox9.js?dpl=dpl_4pprbRpM6o759okqyPapaAMa6Kqp\",\"/_next/static/chunks/0-kl6gjryz-h~.js?dpl=dpl_4pprbRpM6o759okqyPapaAMa6Kqp\",\"/_next/static/chunks/08ovny-lmblrm.js?dpl=dpl_4pprbRpM6o759okqyPapaAMa6Kqp\"],\"default\"]\n"])</script><script>self.__next_f.push([1,"12c:[\"$\",\"$L12b\",\"1\",{\"href\":\"#detailed-safety-evaluations\",\"external\":false,\"className\":\"underline-offset-[0.25rem] underline decoration-1 hover:text-primary-60 text-primary-100\",\"children\":[[[\"$\",\"$1\",\"0\",{\"children\":[[\"$\",\"span\",\"text-end-0\",{\"children\":[\"Appendix\"]}]]}]],\"⁠\"]}]\n12d:[\"$\",\"$1\",\"2\",{\"children\":[[\"$\",\"span\",\"text-end-0\",{\"children\":[\"). We find that the o1 models either have parity or out-perform the GPT‑4o model. In particular, both o1‑preview and o1‑mini, and o1 substantially improve over GPT‑4o on our more challenging refusal evaluation.\"]}]]}]\n136:[\"$\",\"$1\",\"0\",{\"children\":[[\"$\",\"span\",\"text-end-0\",{\"children\":[\"We analyzed the conversations where o1 was perceived as less safe than GPT‑4o and found some common themes across the data:\"]}]]}]\n"])</script><script>self.__next_f.push([1,"137:[\"$\",\"ul\",\"5\",{\"className\":\"mb-md marker:text-inherit last:mb-0 in-[:where(ul,ol)]:mt-2 list-disc in-[:where(ul,ol)]:list-[circle] ps-2xs mx-3xs\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"mb-4xs\",\"children\":[[\"$\",\"b\",\".$0\",{\"children\":[[\"$\",\"span\",\"text-end-0\",{\"children\":[\"More Detailed Responses to Potentially Dangerous Advice:\"]}]]}],[\"$\",\"$1\",\".$1\",{\"children\":[[\"$\",\"span\",\"text-end-0\",{\"children\":[\" o1, by default, injects significantly more detail into responses. This was rated as more unsafe when the prompts were asking for dangerous or illicit advice. These additional details were perceived to decrease the safety of the response in some cases. \"]}]]}]]}],[\"$\",\"li\",\"1\",{\"className\":\"mb-4xs\",\"children\":[[\"$\",\"b\",\".$0\",{\"children\":[[\"$\",\"span\",\"text-end-0\",{\"children\":[\"Engaging with Risky Advice:\"]}]]}],[\"$\",\"$1\",\".$1\",{\"children\":[[\"$\",\"span\",\"text-end-0\",{\"children\":[\" In many instances, GPT‑4o responded with generic advice in response to prompts asking for risky advice while o1 engaged more deeply. This deeper engagement could increase the risk of over-reliance. For example, while asking about techniques to attach a rope during rock climbing, o1 would engage more deeply increasing the chances of over-reliance on it for risky tasks. \"]}]]}]]}],[\"$\",\"li\",\"2\",{\"className\":\"mb-4xs\",\"children\":[[\"$\",\"b\",\".$0\",{\"children\":[[\"$\",\"span\",\"text-end-0\",{\"children\":[\"Refusal Style:\"]}]]}],[\"$\",\"$1\",\".$1\",{\"children\":[[\"$\",\"span\",\"text-end-0\",{\"children\":[\" Some o1 refusals were more terse, omitting specific resources, references, and explanatory context. RTN members sometimes preferred GPT‑4o due to more expository refusals.\"]}]]}]]}],[\"$\",\"li\",\"3\",{\"className\":\"mb-4xs\",\"children\":[[\"$\",\"b\",\".$0\",{\"children\":[[\"$\",\"span\",\"text-end-0\",{\"children\":[\"Policy Tension:\"]}]]}],[\"$\",\"$1\",\".$1\",{\"children\":[[\"$\",\"span\",\"text-end-0\",{\"children\":[\" There were some instances where certain policies OpenAI has trained into the model could conflict with giving responses that red teamers would deem “safer.” This was particularly noticed for queries on health-related topics where o1 would sometimes resist carrying out trait attribution despite it being relevant for more informed responses.\"]}]]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"13b:[\"$\",\"p\",\"4\",{\"className\":\"mb-sm last:mb-0\",\"children\":[[\"$\",\"$1\",\"0\",{\"children\":[[\"$\",\"span\",\"text-end-0\",{\"children\":[\"The exact performance numbers for the model used in production may vary depending on final parameters, system prompt, and other factors. The model tested below as the o1 model was a near-final, post-mitigation model.\"]}]]}]]}]\n13f:[\"$\",\"p\",\"4\",{\"className\":\"mb-sm last:mb-0\",\"children\":[[\"$\",\"$1\",\"0\",{\"children\":[[\"$\",\"span\",\"text-end-0\",{\"children\":[\"We evaluate o1 with iterative debugging and access to tools available in the \"]}]]}],[\"$\",\"$L12b\",\"1\",{\"href\":\"https://www.kali.org/\",\"external\":true,\"className\":\"underline-offset-[0.25rem] underline decoration-1 hover:text-primary-60 text-primary-100\",\"children\":[[[\"$\",\"$1\",\"0\",{\"children\":[[\"$\",\"span\",\"text-end-0\",{\"children\":[\"headless Kali Linux distribution\"]}]]}]],\"⁠\"]}],[\"$\",\"$1\",\"2\",{\"children\":[[\"$\",\"span\",\"text-end-0\",{\"children\":[\" (with up to 60 rounds of tool use for each attempt). Given 12 attempts at each task, o1 (Post-Mitigation) completes 46.0% of high-school level, 13.0% of collegiate level, and 13.0% of professional level CTF challenges. The o1 model performs comparably or worse than o1‑preview (50% high school, 25% collegiate, 16% professional), with the gap largely due to better instruction-following of o1‑preview. We judge that consistent with o1‑preview and o1‑mini, o1 does not sufficiently advance real-world vulnerability exploitation capabilities to meet our medium risk threshold.\"]}]]}]]}]\n14f:[\"$\",\"li\",\"4\",{\"className\":\"mb-4xs\",\"children\":[[\"$\",\"$1\",\".$0\",{\"children\":[[\"$\",\"span\",\"text-end-0\",{\"children\":[\"Collect n = 3,000 evaluations and compare scores between human and AI-generated responses.\"]}]]}]]}]\n150:[\"$\",\"p\",\"7\",{\"className\":\"mb-sm last:mb-0\",\"children\":[[\"$\",\"$1\",\"0\",{\"children\":[[\"$\",\"span\",\"text-end-0\",{\"children\":[\"We measure the AI persuasiveness percentile relative to humans, where AI persuasiveness percentile is equivalent to the probability that a randomly selected model-generated response is rated as more persuasive than a randomly selected human response. This outcome variable can be roughly interpreted as: In terms of persuasiveness, what percentile do AI models attain relative to humans?\"]}]]}]]}]\n15a:[\"$\",\"code\",\".$5\",{\"children\":[[\"$\",\"span\",\"text-end-0\",{\"children\":[\"api/v1/completions with model=\\\"mistral-7b\\\"\"]}]]}]\n15b:[\"$\",\"$1\",\".$6\",{\"children\":[[\"$\",\"span\",\"text-end-0\",{\"children\":[\", \"]}]]}]\n15c:[\"$\",\"code\",\".$7\",{\"children\":[[\"$\",\"span\",\"text-end-0\",{\"children\":[\"prompt\"]}]]}]\n15d:[\"$\",\"$1\",\".$8\",{\"children\":[[\"$\",\"span\",\"text-end-0\",{\"children\":[\", \"]}]]}]\n15e:[\"$\",\"code\",\".$9\",{\"children\":[[\"$\",\"span\",\"text-end-0\",{\"children\":[\"max_tokens\"]}]]}]\n15f:[\"$\",\"$1\",\".$10\",{\"children\":[[\"$\",\"span\",\"text-end-0\",{\"children\":[\", \"]}]]}]\n160:[\"$\",\"code\",\".$11\",{\"children\":[[\"$\",\"span\",\"text-end-0\",{\"children\":[\"temperature\"]}]]}]\n161:[\"$\",\