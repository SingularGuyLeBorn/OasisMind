ata)\n\n# --- 2) Create fictional data for Asia ---\nasia_data = {\n    'City': ['Bangkok', 'Ho Chi Minh', 'Tokyo', 'Kuala Lumpur', 'Seoul'],\n    'Tourism Growth (YoY %)': [12.5, 14.0, 5.0, 13.0, 6.5],\n    'Projected GDP Growth (3-yr)': [3.0, 4.2, 1.8, 3.5, 2.2],\n    'Avg. Occupancy Rate (%)': [70, 68, 83, 67, 80],\n    'ADR (USD)': [90, 75, 220, 85, 140]\n}\ndf_asia = pd.DataFrame(asia_data)\n\n# --- 3) Bar Chart: Tourism Growth (Europe) ---\nplt.bar(df_europe['City'], df_europe['Tourism Growth (YoY %)'])\nplt.title('Tourism Growth (YoY %) - Europe')\nplt.xlabel('City')\nplt.ylabel('Tourism Growth (YoY %)')\nplt.show()\n\n# --- 4) Bar Chart: Avg. Occupancy Rate (Europe) ---\nplt.bar(df_europe['City'], df_europe['Avg. Occupancy Rate (%)'])\nplt.title('Average Occupancy Rate (%) - Europe')\nplt.xlabel('City')\nplt.ylabel('Occupancy Rate (%)')\nplt.show()\n\n# --- 5) Bar Chart: Tourism Growth (Asia) ---\nplt.bar(df_asia['City'], df_asia['Tourism Growth (YoY %)'])\nplt.title('Tourism Growth (YoY %) - Asia')\nplt.xlabel('City')\nplt.ylabel('Tourism Growth (YoY %)')\nplt.show()\n\n# --- 6) Bar Chart: Avg. Occupancy Rate (Asia) ---\nplt.bar(df_asia['City'], df_asia['Avg. Occupancy Rate (%)'])\nplt.title('Average Occupancy Rate (%) - Asia')\nplt.xlabel('City')\nplt.ylabel('Occupancy Rate (%)')\nplt.show()\n"])</script><script>self.__next_f.push([1,"9a:[\"$\",\"$1\",\"3xaNZvz5mYw4l6QOdJYDf6\",{\"children\":[[\"$\",\"$L6a\",null,{\"moduleIds\":\"$74:props:children:1:props:children:1:props:children:props:children:1:props:children:1:props:tabs:0:content:props:children:0:props:moduleIds\"}],[\"$\",\"$L99\",null,{\"id\":\"3xaNZvz5mYw4l6QOdJYDf6\",\"conversations\":[{\"headline\":\"OpenAI o3\",\"messages\":[{\"variant\":\"input\",\"messageText\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"I own a boutique hotel chain with locations in Lisbon, Berlin, and London. I plan to expand into a new country in Europe, and a city in Asia, in 2026. What factors—such as tourism growth, seasonal occupancy patterns, and local economic indicators—best predict success? I want to be ahead of the curve and be in the next hot city before others. Pull regional travel data, economic statistics, and hotel occupancy rates; analyze trends visually and recommend ideal expansion locations.\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"autoExpandContext\":false,\"id\":\"5zVOmOvEalcEr7hbx9Ikpy\",\"__typename\":\"chatGPTMessage\"},{\"variant\":\"response\",\"messageText\":{\"data\":{},\"content\":[{\"data\":{\"target\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"id\":\"7HwUlclQYOJ5yRplGiSklB\",\"type\":\"Asset\",\"publishedVersion\":3,\"revision\":1,\"locale\":\"en-US\"},\"fields\":{\"title\":\"Screenshot 2025-04-14 at 4.31.55 PM\",\"description\":\"\",\"file\":{\"url\":\"//images.ctfassets.net/kftzwdyauwt9/7HwUlclQYOJ5yRplGiSklB/c6807f744deadc21a9cc4f576e6b2f2f/Screenshot_2025-04-14_at_4.31.55_PM.png\",\"details\":{\"size\":160178,\"image\":{\"width\":1246,\"height\":816}},\"fileName\":\"Screenshot 2025-04-14 at 4.31.55 PM.png\",\"contentType\":\"image/png\"}}}},\"content\":[],\"nodeType\":\"embedded-asset-block\"},{\"data\":{\"target\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"id\":\"4PMLv9WKD11DUDxPbjF9Dh\",\"type\":\"Asset\",\"publishedVersion\":3,\"revision\":1,\"locale\":\"en-US\"},\"fields\":{\"title\":\"Screenshot 2025-04-14 at 4.32.01 PM\",\"description\":\"\",\"file\":{\"url\":\"//images.ctfassets.net/kftzwdyauwt9/4PMLv9WKD11DUDxPbjF9Dh/6b915dc628932b8d24708e99537b9daf/Screenshot_2025-04-14_at_4.32.01_PM.png\",\"details\":{\"size\":143038,\"image\":{\"width\":1256,\"height\":814}},\"fileName\":\"Screenshot 2025-04-14 at 4.32.01 PM.png\",\"contentType\":\"image/png\"}}}},\"content\":[],\"nodeType\":\"embedded-asset-block\"},{\"data\":{},\"content\":[{\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"How we picked the short‑list\",\"nodeType\":\"t