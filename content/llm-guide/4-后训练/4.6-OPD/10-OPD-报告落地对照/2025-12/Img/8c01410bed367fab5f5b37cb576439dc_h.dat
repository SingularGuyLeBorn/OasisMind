-balance scroll-mt-[calc(var(--header-h)+var(--toc-button-h))]">Cost vs performance: o1 and o3</h5></div></div></div><section class="group/component-group @container" data-multi-columns="true"><div class="@container grid w-full grid-cols-12 max-w-container"><div class="gap-xs @md:gap-sm col-span-12 grid w-full grid-cols-1 items-stretch @md:grid-cols-2 @md:gap-y-lg @md:col-span-10 @md:col-start-2"><div class="multi-columns:flex multi-columns:px-0 @container grid w-full grid-cols-12 max-w-container"><div class="multi-columns:w-full col-span-12"><div class="gap-3xs grid size-full grid-cols-1 @md:grid-cols-1"><div class="flex flex-col w-full mx-auto ease-curve-c duration-medium transition-opacity max-w-container-desktop relative min-h-0"><div class="relative min-h-0 w-full"><div class="size-full"><div class="group relative overflow-hidden rounded-md aspect-auto size-full bg-surface-loading"><picture class="mx-auto"><source media="(min-width: 768px) and (prefers-color-scheme: dark)" srcSet="https://images.ctfassets.net/kftzwdyauwt9/5bbO5DOoHZFGQr0gEg7x8J/53e1345744fd28788e1f16698b69f60b/o3-o4_AIME2025_dark.png?w=640&amp;q=80&amp;fm=webp 640w, https://images.ctfassets.net/kftzwdyauwt9/5bbO5DOoHZFGQr0gEg7x8J/53e1345744fd28788e1f16698b69f60b/o3-o4_AIME2025_dark.png?w=750&amp;q=80&amp;fm=webp 750w, https://images.ctfassets.net/kftzwdyauwt9/5bbO5DOoHZFGQr0gEg7x8J/53e1345744fd28788e1f16698b69f60b/o3-o4_AIME2025_dark.png?w=828&amp;q=80&amp;fm=webp 828w, https://images.ctfassets.net/kftzwdyauwt9/5bbO5DOoHZFGQr0gEg7x8J/53e1345744fd28788e1f16698b69f60b/o3-o4_AIME2025_dark.png?w=1080&amp;q=80&amp;fm=webp 1080w, https://images.ctfassets.net/kftzwdyauwt9/5bbO5DOoHZFGQr0gEg7x8J/53e1345744fd28788e1f16698b69f60b/o3-o4_AIME2025_dark.png?w=1200&amp;q=80&amp;fm=webp 1200w, https://images.ctfassets.net/kftzwdyauwt9/5bbO5DOoHZFGQr0gEg7x8J/53e1345744fd28788e1f16698b69f60b/o3-o4_AIME2025_dark.png?w=1920&amp;q=80&amp;fm=webp 1920w, https://images.ctfassets.net/kftzwdyauwt9/5bbO5DOoHZFGQr0gEg7x8J/53e1345744fd28788e1f16698b69f60b/o3-o4_AIME2025_dark.png?w=2048&amp;q=80&amp;fm=webp 2048w, https://images.ctfassets.net/kftzwdyauwt9/5bbO5DOoHZFGQr0gEg7x8J/53e1345744fd28788e1f16698b69f60b/o3-o4_AIME2025_dark.png?w=3840&amp;q=80&amp;fm=webp 3840w"/><source media="(min-width: 768px)" srcSet="https://images.ctfassets.net/kftzwdyauwt9/1NDcqcms5r7NFdbdlhVdCX/008e39fe5112baa135c727f15c569508/o3-o4_AIME2025.png?w=640&amp;q=80&amp;fm=webp 640w, https://images.ctfassets.net/kftzwdyauwt9/1NDcqcms5r7NFdbdlhVdCX/008e39fe5112baa135c727f15c569508/o3-o4_AIME2025.png?w=750&amp;q=80&amp;fm=webp 750w, https://images.ctfassets.net/kftzwdyauwt9/1NDcqcms5r7NFdbdlhVdCX/008e39fe5112baa135c727f15c569508/o3-o4_AIME2025.png?w=828&amp;q=80&amp;fm=webp 828w, https://images.ctfassets.net/kftzwdyauwt9/1NDcqcms5r7NFdbdlhVdCX/008e39fe5112baa135c727f15c569508/o3-o4_AIME2025.png?w=1080&amp;q=80&amp;fm=webp 1080w, https://images.ctfassets.net/kftzwdyauwt9/1NDcqcms5r7NFdbdlhVdCX/008e39fe5112baa135c727f15c569508/o3-o4_AIME2025.png?w=1200&amp;q=80&amp;fm=webp 1200w, https://images.ctfassets.net/kftzwdyauwt9/1NDcqcms5r7NFdbdlhVdCX/008e39fe5112baa135c727f15c569508/o3-o4_AIME2025.png?w=1920&amp;q=80&amp;fm=webp 1920w, https://images.ctfassets.net/kftzwdyauwt9/1NDcqcms5r7NFdbdlhVdCX/008e39fe5112baa135c727f15c569508/o3-o4_AIME2025.png?w=2048&amp;q=80&amp;fm=webp 2048w, https://images.ctfassets.net/kftzwdyauwt9/1NDcqcms5r7NFdbdlhVdCX/008e39fe5112baa135c727f15c569508/o3-o4_AIME2025.png?w=3840&amp;q=80&amp;fm=webp 3840w"/><source media="(max-width: 767px) and (prefers-color-scheme: dark)" srcSet="https://images.ctfassets.net/kftzwdyauwt9/5bbO5DOoHZFGQr0gEg7x8J/53e1345744fd28788e1f16698b69f60b/o3-o4_AIME2025_dark.png?w=640&amp;q=70&amp;fm=webp 640w, https://images.ctfassets.net/kftzwdyauwt9/5bbO5DOoHZFGQr0gEg7x8J/53e1345744fd28788e1f16698b69f60b/o3-o4_AIME2025_dark.png?w=750&amp;q=70&amp;fm=webp 750w, https://images.ctfassets.net/kftzwdyauwt9/5bbO5DOoHZFGQr0gEg7x8J/53e1345744fd28788e1f16698b69f60b/o3-o4_AIME2025_dark.png?w=828&amp;q=70&amp;fm=webp 828w, https://images.ctfassets.net/kftzwdyauwt9/5bbO5DOoHZFGQr0gEg7x8J/53e1345744fd28788e1f16698b69f60b/o3-o4_AIME2025_dark.png?w=1080&amp;q=70&amp;fm=webp 1080w, https://images.ctfassets.net/kftzwdyauwt9/5bbO5DOoHZFGQr0gEg7x8J/53e1345744fd28788e1f16698b69f60b/o3-o4_AIME2025_dark.png?w=1200&amp;q=70&amp;fm=webp 1200w, https://images.ctfassets.net/kftzwdyauwt9/5bbO5DOoHZFGQr0gEg7x8J/53e1345744fd28788e1f16698b69f60b/o3-o4_AIME2025_dark.png?w=1920&amp;q=70&amp;fm=webp 1920w, https://images.ctfassets.net/kftzwdyauwt9/5bbO5DOoHZFGQr0gEg7x8J/53e1345744fd28788e1f16698b69f60b/o3-o4_AIME2025_dark.png?w=2048&amp;q=70&amp;fm=webp 2048w, https://images.ctfassets.net/kftzwdyauwt9/5bbO5DOoHZFGQr0gEg7x8J/53e1345744fd28788e1f16698b69f60b/o3-o4_AIME2025_dark.png?w=3840&amp;q=70&amp;fm=webp 3840w"/><img alt="OpenAI o3 and o4 AIME evals" data-nosnippet="true" loading="lazy" width="2300" height="2300" decoding="async" data-nimg="1" class="mx-auto" style="color:transparent" sizes="(min-width: 1728px) 1728px, 100vw" srcSet="https://images.ctfassets.net/kftzwdyauwt9/1NDcqcms5r7NFdbdlhVdCX/008e39fe5112baa135c727f15c569508/o3-o4_AIME2025.png?w=640&amp;q=90&amp;fm=webp 640w, https://images.ctfassets.net/kftzwdyauwt9/1NDcqcms5r7NFdbdlhVdCX/008e39fe5112baa135c727f15c569508/o3-o4_AIME2025.png?w=750&amp;q=90&amp;fm=webp 750w, https://images.ctfassets.net/kftzwdyauwt9/1NDcqcms5r7NFdbdlhVdCX/008e39fe5112baa135c727f15c569508/o3-o4_AIME2025.png?w=828&amp;q=90&amp;fm=webp 828w, https://images.ctfassets.net/kftzwdyauwt9/1NDcqcms5r7NFdbdlhVdCX/008e39fe5112baa135c727f15c569508/o3-o4_AIME2025.png?w=1080&amp;q=90&amp;fm=webp 1080w, https://images.ctfassets.net/kftzwdyauwt9/1NDcqcms5r7NFdbdlhVdCX/008e39fe5112baa135c727f15c569508/o3-o4_AIME2025.png?w=1200&amp;q=90&amp;fm=webp 1200w, https://images.ctfassets.net/kftzwdyauwt9/1NDcqcms5r7NFdbdlhVdCX/008e39fe5112baa135c727f15c569508/o3-o4_AIME2025.png?w=1920&amp;q=90&amp;fm=webp 1920w, https://images.ctfassets.net/kftzwd