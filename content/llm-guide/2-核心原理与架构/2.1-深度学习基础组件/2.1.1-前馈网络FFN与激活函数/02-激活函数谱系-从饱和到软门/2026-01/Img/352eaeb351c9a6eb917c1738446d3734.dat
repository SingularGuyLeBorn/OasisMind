dex/openai-baselines-ppo\",\"external\":false,\"className\":\"underline-offset-[0.25rem] underline decoration-1 hover:text-primary-60 text-primary-100\",\"children\":[[[\"$\",\"$1\",\"0\",{\"children\":[[\"$\",\"span\",\"text-end-0\",{\"children\":[\"Proximal Policy Optimization\"]}]]}]],\"⁠\"]}],[\"$\",\"$1\",\"2\",{\"children\":[[\"$\",\"span\",\"text-end-0\",{\"children\":[\". We performed several iterations of this process.\"]}]]}]]}]]}]}]]}],[\"$\",\"$1\",\"3XqWd8fRZzPHuCIJIK7Zqq\",{\"children\":[[\"$\",\"$L67\",null,{\"moduleIds\":[2090]}],[\"$\",\"div\",null,{\"className\":\"multi-columns:flex multi-columns:px-0 @container grid w-full grid-cols-12 max-w-container\",\"children\":[\"$\",\"div\",null,{\"className\":\"multi-columns:w-full col-span-12 @md:col-span-10 @md:col-start-2\",\"children\":[\"$\",\"div\",null,{\"className\":\"gap-3xs grid size-full grid-cols-1 @md:grid-cols-1 max-w-container p-0\",\"children\":[[\"$\",\"$L96\",\"4U1R7Do6jbwR91YqKZPPFd\",{\"asset\":{\"title\":\"index/chatgpt \u003e Methods \u003e Media \u003e Chatgpt Diagram Light\",\"description\":\"\",\"file\":{\"url\":\"//images.ctfassets.net/kftzwdyauwt9/40in10B8KtAGrQvwRv5cop/8241bb17c283dced48ea034a41d7464a/chatgpt_diagram_light.png\",\"details\":{\"size\":187384,\"image\":{\"width\":1940,\"height\":1153}},\"fileName\":\"chatgpt_diagram_light.png\",\"contentType\":\"image/png\"}},\"altText\":\"Diagram showing the three-step methodology behind the training of ChatGPT.\",\"assetDark\":{\"title\":\"index/chatgpt \u003e Methods \u003e Media \u003e Chatgpt Diagram Dark\",\"description\":\"\",\"file\":{\"url\":\"//images.ctfassets.net/kftzwdyauwt9/6yuK9FKAvoVXNyrsdMoBHH/03ccaf7da203052ba7550965f0021bdf/chatgpt_diagram_dark.png\",\"details\":{\"size\":188376,\"image\":{\"width\":1940,\"height\":1153}},\"fileName\":\"chatgpt_diagram_dark.png\",\"contentType\":\"image/png\"}},\"videoShowMuteButton\":true,\"copyToClipboard\":false,\"id\":\"4U1R7Do6jbwR91YqKZPPFd\",\"__typename\":\"mediaItem\",\