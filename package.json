{
  "name": "oasismind",
  "version": "0.1.0",
  "private": true,
  "description": "见微 · OasisMind — 本地优先的数字主力与知识花园",
  "scripts": {
    "setup:dev": "node scripts/setup-dev-env.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:quick": "node scripts/dev.mjs --quick",
    "dev:stable": "node scripts/dev.mjs --stable",
    "dev:qq": "node scripts/dev.mjs --stable --quick",
    "dev:quick:stable": "node scripts/dev.mjs --quick --stable",
    "dev:remote": "node scripts/dev.mjs --remote",
    "remote": "node scripts/remote.mjs",
    "remote:named": "node scripts/remote.mjs --named",
    "dev:ngrok": "node scripts/remote-ngrok.mjs",
    "dev:ngrok:quick": "node scripts/remote-ngrok.mjs --quick",
    "dev:web": "pnpm --filter @oasismind/web dev",
    "dev:server": "pnpm --filter @oasismind/server dev",
    "dev:mock-llm": "pnpm --filter @oasismind/mock-llm dev",
    "start:mock-llm": "pnpm --filter @oasismind/mock-llm start",
    "build": "pnpm --filter @oasismind/web build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:evals": "pnpm --filter @oasismind/server exec tsx ../../evals/scripts/run-golden.mjs",
    "test:bench": "pnpm --filter @oasismind/server exec tsx ../../evals/scripts/run-harness-bench.mjs",
    "test:e2e": "pnpm --filter @oasismind/web test:e2e",
    "test:e2e:mock": "pnpm --filter @oasismind/web test:e2e:mock",
    "validate": "pnpm lint && pnpm test && pnpm build && pnpm test:e2e",
    "tunnel:quick": "powershell -ExecutionPolicy Bypass -File scripts/tunnel.ps1 quick",
    "tunnel:run": "powershell -ExecutionPolicy Bypass -File scripts/tunnel.ps1 run",
    "tunnel:run:config": "powershell -ExecutionPolicy Bypass -File scripts/tunnel.ps1 run -Config cloudflare/config.yml",
    "db:migrate": "pnpm --filter @oasismind/server db:migrate",
    "db:studio": "pnpm --filter @oasismind/server db:studio",
    "db:seed": "pnpm --filter @oasismind/server db:seed",
    "db:sync": "pnpm --filter @oasismind/server db:sync",
    "db:backup": "node scripts/backup-db.mjs",
    "data:reset": "node scripts/reset-data.mjs",
    "data:reset:yes": "node scripts/reset-data.mjs --yes",
    "data:reset:all": "node scripts/reset-data.mjs --yes --all",
    "ocr:copy": "node scripts/copy-ocr-from-metablog.mjs",
    "ocr:setup": "py -3.10 -m pip install -r tools/ocr/requirements.txt",
    "ocr:check": "pnpm --filter @oasismind/server ocr:check",
    "integration:smoke": "pnpm --filter @oasismind/server integration:smoke",
    "integration:smoke:platform": "pnpm --filter @oasismind/server integration:smoke:platform",
    "integration:smoke:platform:quick": "pnpm --filter @oasismind/server integration:smoke:platform:quick",
    "integration:smoke:platform:medium": "pnpm --filter @oasismind/server integration:smoke:platform:medium",
    "integration:smoke:platform:extended": "pnpm --filter @oasismind/server integration:smoke:platform:extended",
    "read-article:spot": "pnpm --filter @oasismind/server read-article:spot",
    "cleanup:smoke-artifacts": "pnpm --filter @oasismind/server cleanup:smoke-artifacts",
    "napcat": "node scripts/start-napcat.mjs",
    "email:test": "node scripts/email-test.mjs"
  },
  "devDependencies": {
    "concurrently": "9.1.2",
    "cross-env": "10.1.0",
    "emoji-regex": "10.6.0",
    "typescript": "5.8.3"
  }
}